<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PPDO.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides IHttpContextAccessor, HttpContext — needed by JwtMiddleware and CurrentUserService -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <!-- PPDO-231: EF Core 10's SqlServer provider brings Microsoft.Data.SqlClient 6.1.7, which pulls
         System.Security.Cryptography.Pkcs 9.0.11 (CVE-2026-84008 / CVE-2026-70162, DoS). Pinned to
         the patched 10.0.13 until a SqlClient release carries a fixed version itself. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- Word export (PPDO-158, Investment_Proposal_Spec.md decision 27). Already resolved through
         ClosedXML; pinned explicitly at that same version so a ClosedXML upgrade cannot move the
         Word writer silently. Keep the two in step. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\InvestmentProposalTemplate.docx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PPDO.Domain\PPDO.Domain.csproj" />
    <ProjectReference Include="..\PPDO.Application\PPDO.Application.csproj" />
  </ItemGroup>

</Project>
