<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>PPDO.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The external AIP API's JSON Schema contract (PPDO-12/PPDO-14) — linked rather than copied
         so ExternalAipSchemaContractTests always validates against the same file the spec ships,
         never a stale duplicate. -->
    <None Include="..\..\docs\external-api\aip-response.schema.json"
          Link="TestAssets\aip-response.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PPDO.Application\PPDO.Application.csproj" />
    <ProjectReference Include="..\PPDO.Infrastructure\PPDO.Infrastructure.csproj" />
    <!-- Endpoint tests (PPDO.Tests/Functions) exercise the handlers' auth + division-clamp logic,
         which lives above the service layer. Referencing the worker project is enough — the
         isolated worker's HttpRequestData/HttpResponseData are faked in FunctionHttpHarness.cs. -->
    <ProjectReference Include="..\PPDO.Functions\PPDO.Functions.csproj" />
  </ItemGroup>

</Project>
